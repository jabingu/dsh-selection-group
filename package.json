{
  "name": "dsh-selection-group",
  "version": "1.3.8",
  "description": "Selection Toolbar (dsh-selection-group): one self-contained DSH selection toolbar — a single hover box offering annotate and quote, with neither upstream plugin installed.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^27.0.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs",
    "verify": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "selection",
    "annotation",
    "quote",
    "toolbar"
  ],
  "author": "jabingu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jabingu/dsh-selection-group.git"
  },
  "homepage": "https://github.com/jabingu/dsh-selection-group#readme",
  "bugs": {
    "url": "https://github.com/jabingu/dsh-selection-group/issues"
  }
}
